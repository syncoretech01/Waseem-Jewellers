{
  "name": "waseem-jewellers",
  "version": "0.1.0",
  "private": true,
  "description": "Waseem Jewellers — digital flagship, Stage 1 local experience",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -p 3300",
    "build": "node --max-old-space-size=6144 ./node_modules/next/dist/bin/next build",
    "start": "next start -p 3300",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm run copy:check && npm run nlu:check && npm run enquiry:check && npm run build && npm run secret:scan",
    "assets:images": "node scripts/assets/localize.mjs",
    "assets:videos": "node scripts/assets/encode-videos.mjs",
    "assets": "npm run assets:videos && npm run assets:images",
    "brand:extract": "node scripts/brand/extract.mjs",
    "brand:trace": "node scripts/brand/trace.mjs",
    "brand:build": "node scripts/brand/extract.mjs && node scripts/brand/assemble.mjs && node scripts/brand/icons.mjs",
    "brand:check": "node scripts/brand/verify.mjs",
    "brand": "npm run brand:build && npm run brand:check",
    "copy:check": "node scripts/dev/copy-guard.mjs",
    "catalogue:fetch": "node scripts/catalogue/fetch.mjs",
    "catalogue:parse": "node scripts/catalogue/parse.mjs",
    "catalogue:classify": "node scripts/catalogue/classify.mjs",
    "catalogue:media": "node scripts/catalogue/media.mjs",
    "catalogue:emit": "node scripts/catalogue/emit.mjs",
    "catalogue:audit": "node scripts/catalogue/audit.mjs",
    "catalogue:accept": "node scripts/catalogue/audit.mjs --accept",
    "catalogue:verify": "node scripts/catalogue/verify-migration.mjs",
    "catalogue:build": "npm run catalogue:parse && npm run catalogue:classify && npm run catalogue:media && npm run catalogue:emit",
    "catalogue": "npm run catalogue:fetch && npm run catalogue:build && npm run catalogue:verify && npm run catalogue:audit",
    "nlu:check": "node scripts/dev/nlu-check.mjs",
    "enquiry:check": "node scripts/dev/enquiry-check.mjs",
    "bundle:report": "node scripts/dev/bundle-report.mjs",
    "leak:check": "node scripts/dev/leak-check.mjs",
    "secret:scan": "node scripts/dev/secret-scan.mjs"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "maath": "0.10.8",
    "motion": "13.2.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "three": "0.185.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "0.185.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "playwright": "^1.52.0",
    "potrace": "^2.1.8",
    "sharp": "0.35.4",
    "svgo": "^4.1.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
