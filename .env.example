# Waseem Jewellers — Stage 1 runs entirely without credentials.
# Nothing below is required for `npm run dev`.

# ── Concierge provider ──────────────────────────────────────────────────────
# "mock" (default) = the keyless Waseem Concierge (chat + voice) that ships with Stage 1.
# "openai" is reserved for the future OpenAI Realtime provider (see CONCIERGE_ARCHITECTURE.md).
NEXT_PUBLIC_CONCIERGE_PROVIDER=mock

# ── Future OpenAI Realtime (server-side only; never exposed to the browser) ──
# Read exclusively inside src/app/api/concierge/*/route.ts once activated.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin
