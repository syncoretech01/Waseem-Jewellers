# Waseem Jewellers — the site runs entirely without credentials.
# Nothing below is required for `npm run dev`. Copy to `.env.local` only to enable a path.

# ── The server-mediated model (ships dark) ──────────────────────────────────
# Setting the key and redeploying the SAME build activates the model. The bundle does not
# change; the server decides, and the browser asks it through /api/concierge/capabilities.
# Read only in src/server/env.ts, which is `server-only` and banned from client imports.
CONCIERGE_API_KEY=
CONCIERGE_MODEL=gpt-4o-mini
CONCIERGE_BASE_URL=https://api.openai.com/v1
# Signs the continuation between rounds of one turn. Falls back to the key when unset.
CONCIERGE_SIGNING_SECRET=

# ── Consultation delivery (dormant until ALL four are set and valid) ────────
# A visitor's name and telephone number leave their device only when every one of these
# exists — see src/server/enquiry/readiness.ts and `npm run enquiry:check`. A webhook on its
# own leaves the form on the device.
ENQUIRY_WEBHOOK_URL=
NEXT_PUBLIC_SITE_URL=
ENQUIRY_PRIVACY_URL=
ENQUIRY_PRIVACY_CONTACT=

# ── QA ──────────────────────────────────────────────────────────────────────
# A build with this set honours `?tier=HIGH|MEDIUM|LOW|REDUCED` and exposes window.__wjFps,
# so the craft object and the frame-rate monitor can be measured in a headless browser.
# Never set on a production deployment.
NEXT_PUBLIC_QA_TIER_OVERRIDE=

# ── Model-backed voice (ships dark; the browser's own speech is the fallback tier) ──
# Hearing through a transcription model and speaking through a speech model. Setting the key
# and redeploying the SAME build switches it on: /api/concierge/capabilities then answers
# voice: 'server'. Falls back to CONCIERGE_API_KEY when the concierge base is OpenAI's.
# Read only in src/server/env.ts.
OPENAI_API_KEY=
CONCIERGE_STT_MODEL=gpt-4o-transcribe
CONCIERGE_TTS_MODEL=gpt-4o-mini-tts
CONCIERGE_TTS_VOICE=marin
# Optional: a different OpenAI-compatible base for the audio endpoints only.
CONCIERGE_VOICE_BASE_URL=

# ── Reserved for the realtime voice engine (not built) ──────────────────────
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin
